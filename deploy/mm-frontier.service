[Unit]
Description=Machine Memory · fetch new arXiv papers into the frontier shelf
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/machine-memory
ExecStart=/bin/sh -c '/usr/bin/node tools/fetch-arxiv.mjs --max 30 && /usr/bin/node tools/rewrite-frontier.mjs --max 8'
TimeoutStartSec=300
Nice=10
