{
  "name": "machine-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --watch server/src/index.js",
    "start": "node server/src/index.js",
